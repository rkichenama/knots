{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "lib": [ "esnext", "dom" ],
    "module": "esnext",
    "noImplicitAny": false,
    "preserveConstEnums": true,
    "removeComments": true,
    "target": "es2020",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": [
    "src/**/*"
  ]
}